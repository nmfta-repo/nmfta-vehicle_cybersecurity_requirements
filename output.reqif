        <SPEC-OBJECT IDENTIFIER="TEXT-cdf838cf-db3f-44f9-b0cf-3c4b7125cdb2" LAST-CHANGE="2026-10-21T20:41:03Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="This document specifies cybersecurity requirements for Class 2 vehicle components: **Vehicle Gateway**.\n\nClass 2 devices are truck modules intended to perform gateway functions (transport, translate, transform, filter, or encapsulate data) between two or more vehicle network segments.\n\nExamples include:\n- Onboard Diagnostics Connector Gateway (Central Gateway / CGW) (J1939 SA 39, 17, 44, 49, 50, 77)\n- 3rd Party Equipment Gateway (J1939 SA 249)\n- Telematics Interface Gateway">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>TEXT_66ace24f2a4a41759c4efe5436d8c20d_ReqIF.Text</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE>
            <SPEC-OBJECT-TYPE-REF>TEXT_66ace24f2a4a41759c4efe5436d8c20d</SPEC-OBJECT-TYPE-REF>
          </TYPE>
        </SPEC-OBJECT>
