        <SPEC-OBJECT IDENTIFIER="TEXT-a13f4720-6db2-4871-b958-35e3a2e36e45" LAST-CHANGE="2026-10-21T20:41:03Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="This document specifies cybersecurity requirements for Class 6 vehicle components: **Single Segment Medium Risk**.\n\nClass 6 devices are truck modules connected to a single vehicle network segment found to have a medium overall fleet risk.\n\nExamples include:\n- Suspension - Steer Axle / ECS / ECAS (J1939 SA 20)\n- Suspension - System Controller #1 (J1939 SA 47)\n- Automated Driving (L0-L2) / Forward Looking Camera / Radar (Bendix FLR/FLC)\n- Engine Valve Controller (J1939 SA 00)\n- Clutch/Converter Unit (J1939 SA 78)\n- Auxiliary Transmission (J1939 SA 16)\n- Collision Avoidance (J1939 SA 42)\n- Body Controller (Key-Lock Options)\n- Shift Console Primary / Gearshift ECU (J1939 SA 05)\n- Safety Restraint System / SRS (J1939 SA 83)\n- Vehicle Dynamic Stability Controller (J1939 SA 62)\n- Pyrometer\n- Adaptive Front Lighting System (J1939 SA 71)">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>TEXT_b52d86766fe7486f930f2b1e362d7c7f_ReqIF.Text</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE>
            <SPEC-OBJECT-TYPE-REF>TEXT_b52d86766fe7486f930f2b1e362d7c7f</SPEC-OBJECT-TYPE-REF>
          </TYPE>
        </SPEC-OBJECT>
