        <SPEC-OBJECT IDENTIFIER="TEXT-1ba46ebb-59fa-4f8b-b230-6fa720fc3dfa" LAST-CHANGE="2026-10-21T20:41:03Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="This document specifies cybersecurity requirements for Class 5 vehicle components: **Single Segment High Risk**.\n\nClass 5 devices are truck modules connected to a single vehicle network segment found to have a high overall fleet risk based on system criticality and vehicle operational impact.\n\nExamples include:\n- Power TakeOff (Front or Secondary) (J1939 SA 07)\n- Idle Control System (J1939 SA 68)\n- Pneumatic System Controller (J1939 SA 48)\n- Power TakeOff (PTO) Switches (J1939 SA 07)\n- Engine Cylinder Pressure Monitoring System\n- Aftertreatment #1 / #2 system gas intake (J1939 SA 81, 86)\n- Diesel Particulate Filter Controller / Aftertreatment Control Module (ACM) (J1939 SA 211)\n- Engine Exhaust Backpressure (J1939 SA 34)\n- Retarder - Driveline / Exhaust / Engine (J1939 SA 16)">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>TEXT_9b0833816d674821b36ca3587ef2d56a_ReqIF.Text</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE>
            <SPEC-OBJECT-TYPE-REF>TEXT_9b0833816d674821b36ca3587ef2d56a</SPEC-OBJECT-TYPE-REF>
          </TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="SECTION-2967ede9-c76a-46d0-be15-b90f23d5a49e" LAST-CHANGE="2026-10-21T20:41:03Z">
