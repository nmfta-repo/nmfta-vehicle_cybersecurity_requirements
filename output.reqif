        <SPEC-OBJECT IDENTIFIER="TEXT-fed4ed4c-5459-4566-9265-029a091b8b79" LAST-CHANGE="2026-10-21T20:41:03Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="This document specifies cybersecurity requirements for Class 3 vehicle components: **Multi Segment with Untrusted Wired Connection**.\n\nClass 3 devices are truck modules that are not intended to be Vehicle Gateways but nonetheless are connected to two or more vehicle network segments where one or more of those segments are untrusted (e.g. diagnostic ports, trailer bridges, or networks exposed to external physical connections).\n\nExamples include:\n- Tractor/Trailer Bridge #1 / #2 (J1939 SA 32, 138, 39)\n- Powertrain Control Module (CPC) (J1939 SA 90)\n- Engine #1 (MCM / EMS / ECM) (J1939 SA 00, 01)\n- Transmission #1 (TCM) (J1939 SA 03)\n- Cab Controller Primary / Secondary (SAM CAB) (J1939 SA 49, 50)\n- Instrument Cluster #1 (Gauges) (J1939 SA 23)\n- On Board Diagnostic Unit (J1939 SA 250)\n- ADAS Adaptive Cruise Control / Lane Keep (Bendix Fusion) (J1939 SA 42, 232, 19)">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>TEXT_9f925a16d6ea416491e1a5c994a96c14_ReqIF.Text</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE>
            <SPEC-OBJECT-TYPE-REF>TEXT_9f925a16d6ea416491e1a5c994a96c14</SPEC-OBJECT-TYPE-REF>
          </TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="SECTION-6469318c-2d10-4b68-80bb-34c8b5653417" LAST-CHANGE="2026-10-21T20:41:03Z">
