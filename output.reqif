        <SPEC-OBJECT IDENTIFIER="TEXT-db0c262e-380b-4088-93ca-6b44a69894ad" LAST-CHANGE="2026-10-21T20:41:03Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="We would like to acknowledge the contributions of DOT/Volpe Center, motor freight carrier members, and the participants of the NMFTA Vehicle Cybersecurity Requirements Working Group (VCRWG) and Telematics Security Requirements working group.\n\nNamed participants include Derek Held of Zonar Systems, representatives from Geotab, Altaz Valani of Security Compass, Mark Zachos of DG Technologies, Richard M. Litwinczuk (Senior Cybersecurity Engineer, Land Cyber Mission Assurance Program DND), Jacob D&#x27;Aoust (Junior Researcher, DeepMicro Limited), as well as numerous fleet managers, motor carriers, and telematics service providers (TSPs).\n\nThe authors also acknowledge the contributions of the NMFTA Request for Proposal Contract Template Language (RFPCTL) working group.">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>TEXT_e68105741c5740f7bbcbf2e921806b12_ReqIF.Text</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE>
            <SPEC-OBJECT-TYPE-REF>TEXT_e68105741c5740f7bbcbf2e921806b12</SPEC-OBJECT-TYPE-REF>
          </TYPE>
        </SPEC-OBJECT>
