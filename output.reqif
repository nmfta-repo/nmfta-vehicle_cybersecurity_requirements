        <SPEC-OBJECT IDENTIFIER="TEXT-34791320-58bd-46dc-954a-af3532b96e6a" LAST-CHANGE="2026-10-21T20:41:03Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="This document specifies cybersecurity requirements for Class 4 vehicle components: **Multi Segment**.\n\nClass 4 devices are truck modules that are not intended to be Vehicle Gateways but nonetheless are connected to two or more vehicle network segments where all of the segments are trusted (internal closed vehicle subnets).\n\nExamples include:\n- Steering Controller (Front Axle Steering / FAS / VDS / MCS) (J1939 SA 19)\n- Electronic Clutch Actuator (J1939 SA 03)\n- Headway Controller (J1939 SA 42)\n- Engine Injection Control Module (J1939 SA 00)\n- Chassis Controller #2 (J1939 SA 72)\n- Transmission Display Primary (J1939 SA 59)\n- Switch Field (Modular Switch Field / MSF) (J1939 SA 138)">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>TEXT_82e32d4362024ceba14f3b0acaf910fe_ReqIF.Text</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE>
            <SPEC-OBJECT-TYPE-REF>TEXT_82e32d4362024ceba14f3b0acaf910fe</SPEC-OBJECT-TYPE-REF>
          </TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="SECTION-a07fd1ef-503f-4bce-99cc-5481dd110524" LAST-CHANGE="2026-10-21T20:41:03Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Baseline Security Requirements Applicability">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>SECTION_6ecc648f46cd4c979f41855c267ab2f5_ReqIF.ChapterName</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
