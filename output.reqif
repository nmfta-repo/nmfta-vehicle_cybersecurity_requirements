        <SPEC-OBJECT IDENTIFIER="TEXT-eced2966-da22-4812-8766-134394aabdba" LAST-CHANGE="2026-10-21T20:41:03Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Security requirements that must be satisfied by any device which *could be* a gateway (due to malicious code) but is not intended to be one.">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>TEXT_cccf74490ecb437fab6d346011bbc85d_ReqIF.Text</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
