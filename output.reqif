        <SPEC-OBJECT IDENTIFIER="TEXT-91045450-64a5-4f3d-8fc7-e13e1bc8670c" LAST-CHANGE="2026-10-21T20:41:03Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="This document specifies cybersecurity requirements for Class 1 vehicle components: **Multi Segment with Wireless**.\n\nClass 1 devices include truck modules that may or may not be intended to perform gateway functions (transport, translate, transform, filter, or encapsulate data) and possess at least one wireless interface (such as Bluetooth, Wi-Fi, cellular, TPMS RF, or wireless sensor bridges).\n\nExamples include:\n- Antilock Brake System (ABS) (J1939 SA 11)\n- Brakes - System Controller (J1939 SA 11)\n- Tire Pressure Controller / TPMS (J1939 SA 51)\n- Wheel End Monitoring\n- Propulsion Battery Charger (J1939 SA 73)\n- Brakes - Drive Axle #1 / #2 (J1939 SA 13, 14)\n- Vehicle Navigation (J1939 SA 84)\n- Radio / Head Unit / Infotainment (J1939 SA 76, 84)">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>TEXT_6ca80540e6b14f0bb3d8ee98f7244c2f_ReqIF.Text</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE>
            <SPEC-OBJECT-TYPE-REF>TEXT_6ca80540e6b14f0bb3d8ee98f7244c2f</SPEC-OBJECT-TYPE-REF>
          </TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="SECTION-1cdb2d15-55fe-4dd5-9d94-16545f3240b4" LAST-CHANGE="2026-10-21T20:41:03Z">
