        <SPEC-OBJECT IDENTIFIER="TEXT-63124eab-2b58-48c7-a184-eea1bcae0e74" LAST-CHANGE="2026-10-21T20:41:03Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="This document specifies cybersecurity requirements for Class 7 vehicle components: **Single Segment Low Risk**.\n\nClass 7 devices are truck modules connected to a single vehicle network segment found to have a low overall fleet risk.\n\nExamples include:\n- Electric Propulsion Control Unit #1\n- Retarder Display (J1939 SA 23)\n- Shift Console - Secondary (J1939 SA 06)\n- Transmission Display - Secondary (J1939 SA 60)\n- Chassis Controller #1 / SAM Chassis (J1939 SA 71)\n- Passenger-Operator Climate Control #1 / LECM / HVAC (J1939 SA 25)\n- Battery Pack Monitor #1 (J1939 SA 243)\n- Slope Sensor / Hill Start Assist\n- Aftertreatment #1 / #2 system gas outlet / NOx sensors (J1939 SA 82, 87)\n- Axle - Steering (J1939 SA 08)\n- Steering Column Unit / Turn Signal Control\n- Steering Wheel Switches (J1939 SA 77)\n- Auxiliary Valve Control / Engine Air System Valve Control (J1939 SA 34)\n- Catalyst Fluid Sensor / DEF Quality Sensor (J1939 SA 211)\n- Seat Control #1\n- Turbocharger, Wastegate, Compressor Bypass (J1939 SA 02)\n- Door Controller / Door Controllers #1-#4 (J1939 SA 236, 237)\n- Engine Exhaust Gas Recirculation (J1939 SA 70)\n- Cab Display #1\n- Vehicle Security (J1939 SA 29)">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>TEXT_6c3433cbd7d341e58e21128e0ab9868b_ReqIF.Text</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE>
            <SPEC-OBJECT-TYPE-REF>TEXT_6c3433cbd7d341e58e21128e0ab9868b</SPEC-OBJECT-TYPE-REF>
          </TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="SECTION-4f93d323-fe82-459b-bbe1-bc4c102f9f07" LAST-CHANGE="2026-10-21T20:41:03Z">
          <VALUES>
