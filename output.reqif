        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="TEXT-dfd48c81-85ba-4ecd-811e-4ca4aaf7e837" LAST-CHANGE="2026-10-21T20:41:03Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="THE INFORMATION CONTAINED HEREIN IS PROVIDED \u201cAS IS\u201d WITHOUT WARRANTY OF\nANY KIND, EITHER EXPRESSED OR IMPLIED, INCLUDING, BUT NOT LIMITED TO,\nTHE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR\nPURPOSE. THE ENTIRE RISK AS TO THE QUALITY AND PERFORMANCE OF THE\nINFORMATION IS WITH THE USER.\n\nNMFTA and contributing industry working group participants disclaim any\nliability for direct, indirect, incidental, special, or consequential damages\nresulting from the implementation, procurement, or use of these cybersecurity\nrequirements or associated verification procedures.">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>TEXT_e68105741c5740f7bbcbf2e921806b12_ReqIF.Text</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE>
            <SPEC-OBJECT-TYPE-REF>TEXT_e68105741c5740f7bbcbf2e921806b12</SPEC-OBJECT-TYPE-REF>
          </TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="SECTION-de04aca7-daa3-497c-b57a-f419552f9626" LAST-CHANGE="2026-10-21T20:41:03Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Glossary and List of Abbreviations">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>SECTION_7f14638ec1ef4ef98359cb75e1bf97d5_ReqIF.ChapterName</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE>
            <SPEC-OBJECT-TYPE-REF>SECTION_7f14638ec1ef4ef98359cb75e1bf97d5</SPEC-OBJECT-TYPE-REF>
          </TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="TEXT-0f2778fa-ce17-4cb1-908f-30e75f842693" LAST-CHANGE="2026-10-21T20:41:03Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="============== =======================================================\nAbbreviation   Term\n============== =======================================================\nASVS           Application Security Verification Standard\nBSIMM          Building Security in Maturity Model\nCAIQ           Consensus Assessment Initiative Questionnaire\nCAN            Controller Area Network\nCGW            Central Gateway\nCTIA           Cellular Telecommunications and Internet Association\nCyber ITL      Cyber Independent Testing Labs\nDHS            Department of Homeland Security\nDOT            Department of Transportation\nECU            Electronic Control Unit\nELD            Electronic Logging Device\nETSI           European Telecommunications Standards Institute\nFM             Fleet Manager\nFMI            Fleet Management Information\nFMIS           Fleet Management Information System\nHMI            Human Machine Interface\nHDVCR          Heavy Duty Vehicle Cybersecurity Requirements\nIEC            International Electrotechnical Commission\nIS             Information System\nISO            International Organization for Standardization\nIVG            Intelligent Vehicle Gateway\nMAC            Mandatory Access Controls\nMASVS          Mobile Application Security Verification Standard\nMSTG           Mobile Security Testing Guide\nNIST           National Institute of Standards and Technology\nNMFTA          National Motor Freight Traffic Association, Inc.\nOBD            On-Board Diagnostics\nOEM            Original Equipment Manufacturer\nOTA            Over-The-Air Update\nOWASP          Open Web Application Security Project\nRFP            Request for Proposal\nRFPCTL         Request for Proposal Contract Template Language\nTND            Trusted Network Domain\nTSP            Telematics Service Provider\nUID            Unique Identifier\nUND            Untrusted Network Domain\nVCR            Vehicle Cybersecurity Requirements\nVCRWG          Vehicle Cybersecurity Requirements Working Group\nWAN            Wide Area Network\n============== =======================================================\n\nUntrusted Network Domain (UND):\n    A network domain (or segment) that contains **any** of the following:\n    a) wireless communication or reachable wirelessly (e.g. J2497, ISO 15118, Bluetooth, Wi-Fi, cellular)\n    b) an interface for aftermarket devices or operator access (e.g. an OBD port, RP1226 connector)\n    c) a telematics device that does not satisfy the HD VCR requirements\n    d) a multi-network device (e.g. intended or unintended gateway) that does not satisfy the HD VCR requirements\n\nTrusted Network Domain (TND):\n    A network domain (or segment) that **does not contain any** of the untrusted attributes listed above.">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>TEXT_e68105741c5740f7bbcbf2e921806b12_ReqIF.Text</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE>
            <SPEC-OBJECT-TYPE-REF>TEXT_e68105741c5740f7bbcbf2e921806b12</SPEC-OBJECT-TYPE-REF>
          </TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="SECTION-b703b659-7424-4218-8526-dbc2a33d4e48" LAST-CHANGE="2026-10-21T20:41:03Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Purpose, Architectural Scope &amp; Classification Approach">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>SECTION_7f14638ec1ef4ef98359cb75e1bf97d5_ReqIF.ChapterName</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE>
            <SPEC-OBJECT-TYPE-REF>SECTION_7f14638ec1ef4ef98359cb75e1bf97d5</SPEC-OBJECT-TYPE-REF>
          </TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="TEXT-eec9670b-ffe4-486a-8345-70be735c2dce" LAST-CHANGE="2026-10-21T20:41:03Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="The **NMFTA Heavy-Duty Vehicle Cybersecurity Requirements (HD VCR)** specification establishes a comprehensive, structured set of cybersecurity requirements and verification procedures for Electronic Control Units (ECUs) and interconnected subsystems in commercial motor vehicles.\n\nAs modern commercial vehicles incorporate sophisticated electronic architectures, vehicle networks, and off-board connectivity, fleet managers and motor freight carriers bear increasing operational risk. The primary objectives of this specification are to:\n\n1. **Empower Fleet Procurement**: Provide commercial fleets, motor carriers, and vehicle purchasers with actionable, prioritized cybersecurity criteria for evaluating vehicles, systems, and supplier proposals (RFPs).\n2. **Standardize Supplier Expectations**: Define unambiguous, testable security controls for OEMs, Tier-1 suppliers, and aftermarket device manufacturers.\n3. **Establish Verifiable Assurance**: Equip purchasers and independent testing laboratories with concrete verification procedures to validate that required controls are present and effective upon delivery.\n\nArchitectural Approach &amp; ECU Classification:\n=============================================\nCommercial vehicle architectures partition electronic controllers into distinct device classes based on their network topology, external interfaces, gatewaying responsibilities, and overall risk profile:\n\n- **Class 0 (Telematics)**: Systems possessing off-board Wide Area Network (WAN) connectivity (cellular, satellite, internet).\n- **Class 1 (Multi-Segment with Wireless)**: Controllers connected to multiple internal buses with short-range wireless interfaces (Bluetooth, Wi-Fi, TPMS RF).\n- **Class 2 (Vehicle Gateway)**: Dedicated routing, isolation, and message-filtering controllers (Central Gateway / CGW).\n- **Class 3 (Multi-Segment with Untrusted Wired)**: Controllers bridging internal networks to untrusted physical connectors (OBD-II, RP1226, trailer bridges).\n- **Class 4 (Multi-Segment Trusted)**: Multi-segment controllers where all attached buses are internal and trusted.\n- **Class 5 (Single-Segment High Risk)**: Single-segment controllers whose disruption presents critical operational or safety impact (e.g., emissions/aftertreatment, retarders).\n- **Class 6 (Single-Segment Medium Risk)**: Single-segment controllers of moderate operational risk (e.g., suspension, automated steering assists).\n- **Class 7 (Single-Segment Low Risk)**: Single-segment controllers of low fleet risk (e.g., cab convenience, HVAC, door modules).\n\nFor physical vehicle controllers (Classes 1 through 7), requirements apply directly to the physical ECU hardware and its firmware. However, telematics systems (Class 0) represent a distributed system architecture requiring specialized decomposition, as described in the following section.">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>TEXT_e68105741c5740f7bbcbf2e921806b12_ReqIF.Text</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE>
            <SPEC-OBJECT-TYPE-REF>TEXT_e68105741c5740f7bbcbf2e921806b12</SPEC-OBJECT-TYPE-REF>
          </TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="SECTION-04ea67bd-71e5-4ab1-a435-b0a4d1d9bf74" LAST-CHANGE="2026-10-21T20:41:03Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Telematics Systems in Commercial Fleets: Special Handling &amp; Evaluation Guidance">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>SECTION_7f14638ec1ef4ef98359cb75e1bf97d5_ReqIF.ChapterName</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE>
            <SPEC-OBJECT-TYPE-REF>SECTION_7f14638ec1ef4ef98359cb75e1bf97d5</SPEC-OBJECT-TYPE-REF>
          </TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="TEXT-117311d9-a7d3-40d6-9aa3-0721d49f3f61" LAST-CHANGE="2026-10-21T20:41:03Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Special Handling for Class 0 Telematics Systems:\n================================================\nUnlike traditional on-vehicle ECUs (Classes 1 through 7) which are evaluated as individual physical modules, **Class 0 Telematics Systems** encompass a distributed ecosystem extending beyond the vehicle. A telematics solution typically spans four distinct architectural components:\n1. An on-vehicle physical unit (*Vehicle Connection Component*),\n2. A wireless pipe (*Connectivity or Communications Component*),\n3. An off-board server infrastructure (*Cloud or Back-End Component*), and\n4. A driver interface (*Mobile App or Driver Display Component*).\n\nBecause of this distributed nature, the telematics requirements derived from the NMFTA Telematics Security Requirements Matrix (TSRM) are handled specially:\n- The specification partitions telematics controls across the four component boundaries.\n- The supplier questionnaires generate four dedicated evaluation worksheets so that procuring fleets can obtain specific attestations from the respective engineering and operations teams.\n\nScope Guidance: Multiple Telematics Systems per Vehicle:\n========================================================\nModern commercial motor vehicles frequently deploy **multiple distinct telematics systems** simultaneously. A single tractor or trailer may incorporate:\n\n- An OEM factory telematics gateway / off-vehicle connectivity unit.\n- An aftermarket Electronic Logging Device (ELD) or Fleet Management Information System (FMIS).\n- Component-specific telematics devices (e.g., Engine, Transmission, or Braking/ABS telematics units).\n- Camera, vision safety, and trailer tracking subsystems.\n\nBecause each deployed telematics system introduces network interfaces and potential attack vectors into the vehicle, **fleets and purchasers must evaluate ALL telematics systems installed on the vehicle**. \n\nWhen issuing supplier questionnaires or evaluating vendor compliance:\n- Procuring fleets MUST ensure that questionnaire recipients complete responses for **ALL** telematics systems present on or integrated with the vehicle.\n- A vendor or supplier providing multiple telematics subsystems must submit separate questionnaire responses for each individual system.\n- An assessment of only one system (e.g., the primary ELD) does not confer cybersecurity assurance to other co-existing telematics systems (e.g., powertrain or trailer telematics).">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>TEXT_e68105741c5740f7bbcbf2e921806b12_ReqIF.Text</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE>
            <SPEC-OBJECT-TYPE-REF>TEXT_e68105741c5740f7bbcbf2e921806b12</SPEC-OBJECT-TYPE-REF>
          </TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="SECTION-c232f034-d589-4955-9661-548fb6e06b19" LAST-CHANGE="2026-10-21T20:41:03Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Requirements Structure and Options Handling (CONTAINS_OPTIONS)">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>SECTION_7f14638ec1ef4ef98359cb75e1bf97d5_ReqIF.ChapterName</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE>
            <SPEC-OBJECT-TYPE-REF>SECTION_7f14638ec1ef4ef98359cb75e1bf97d5</SPEC-OBJECT-TYPE-REF>
          </TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="TEXT-923bcfe3-1097-456f-89b6-ab92c33caa2e" LAST-CHANGE="2026-10-21T20:41:03Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Note on Options for Requirements:\n=================================\nThese specifications contain requirements where the working group cannot reasonably require a particular implementation option, only that one of the satisfactory ways to satisfy the requirement is implemented. Modelling these &#x27;options&#x27; requirements as separate formal nodes is neither practical nor recommended: the sheer number of requirements captured for heavy vehicles means that the requirements must remain machine-readable and there is no machine-readable way to communicate options to implementors (for good reason).\n\nThe approach taken across all VCR requirements documents is to:\na) Include the options as notes to the implementers directly within the requirement statements or comments; and\nb) Tag all requirements with `CONTAINS_OPTIONS` in their `TAGS` field so that the entire list of requirements containing notes to the implementers can be indexed for easy reference by them.">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>TEXT_e68105741c5740f7bbcbf2e921806b12_ReqIF.Text</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
            </ATTRIBUTE-VALUE-STRING>
          </VALUES>
          <TYPE>
            <SPEC-OBJECT-TYPE-REF>TEXT_e68105741c5740f7bbcbf2e921806b12</SPEC-OBJECT-TYPE-REF>
          </TYPE>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="SECTION-480e222b-208f-4f0c-ad72-36123958934b" LAST-CHANGE="2026-10-21T20:41:03Z">
          <VALUES>
            <ATTRIBUTE-VALUE-STRING THE-VALUE="Acknowledgements">
              <DEFINITION>
                <ATTRIBUTE-DEFINITION-STRING-REF>SECTION_7f14638ec1ef4ef98359cb75e1bf97d5_ReqIF.ChapterName</ATTRIBUTE-DEFINITION-STRING-REF>
              </DEFINITION>
